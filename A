firetouchinterest(root, spot.part, 0)
firetouchinterest(root, spot.part, 1)
end)
end
end
if button and button.Parent and typeof(getconnections) == "function" then
for _, signal in ipairs({ "Activated", "MouseButton1Click" }) do
