function ForceMap.start()
if ForceMap.running then
return
end
if ForceMap.map == "" then
ForceMap.finish("Pick or type a map first.")
return
end
if findMap() then
ForceMap.finish("A round is already running, wait for the next vote.")
return
end
local spot = ForceMap.resolve(ForceMap.map)
local button = ForceMap.findButton(ForceMap.map:lower())
if not spot and not button then
ForceMap.finish("Couldn't find " .. ForceMap.map .. " - scan while voting is open")
return
end
ForceMap.running = true
ForceMap.votes = 0
task.spawn(function()
local started = os.clock()
while alive and ForceMap.on do
if findMap() then
ForceMap.finish("Voting ended")
return
end
if os.clock() - started > ForceMap.window then
ForceMap.finish("Voting window over")
return
end
if isAlive(localPlayer) and rootOf(localPlayer) then
ForceMap.cast(spot, button)
ForceMap.votes += 1
task.wait(math.clamp(Predict.ping() / 1000 + 0.12, 0.15, 0.5))
local old = localPlayer.Character
local humanoid = getHumanoid()
if humanoid then
humanoid.Health = 0
end
repeat
task.wait()
until (localPlayer.Character ~= old and isAlive(localPlayer) and rootOf(localPlayer)) or os.clock() - started > ForceMap.window or not ForceMap.on
else
task.wait()
end
end
ForceMap.running = false
end)
end
function ForceMap.roundActive()
if findMap() then
return true
end
local ok, murderer = pcall(getMurderer)
return ok and murderer ~= nil
end
