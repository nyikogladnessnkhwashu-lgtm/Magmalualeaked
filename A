function ForceMap.pick(name)
if ForceMap.on and ForceMap.map == name then
ForceMap.on = false
if els.forceMap then
els.forceMap:Set(false, true)
end
ForceMap.refreshPicker()
return
end
if ForceMap.running then
ForceMap.on = false
local deadline = os.clock() + 2
while ForceMap.running and os.clock() < deadline do
task.wait()
end
ForceMap.running = false
end
ForceMap.map = name
ForceMap.on = true
if els.forceMap then
els.forceMap:Set(true, true)
end
ForceMap.start()
ForceMap.refreshPicker()
end
