local ForceMap = { on = false, running = false, map = "", spots = {}, votes = 0, window = 25 }
local function nameHasVote(instance)
local current = instance
while current and current ~= Workspace do
if current.Name:lower():find("vote", 1, true) then
return true
end
current = current.Parent
end
return false
end
local function labelNear(part)
local scopes = { part, part.Parent }
for _, scope in ipairs(scopes) do
if scope and scope ~= Workspace then
for _, inner in ipairs(scope:GetDescendants()) do
if inner:IsA("TextLabel") and inner.Text ~= "" and #inner.Text <= 40 and not inner.Text:match("^%d+$") then
return inner.Text
end
end
end
end
return nil
end
local function looksLikePad(part)
if part.Name:find("Coin") then
return false
end
if part:FindFirstChildOfClass("TouchTransmitter") then
return true
end
local name = part.Name:lower()
return name:find("vote", 1, true) ~= nil or name:find("pad", 1, true) ~= nil
end
local function guiHost(label)
local gui = label:FindFirstAncestorWhichIsA("SurfaceGui") or label:FindFirstAncestorWhichIsA("BillboardGui")
if not gui then
return nil
end
local host = gui.Adornee or gui.Parent
return (host and host:IsA("BasePart")) and host or nil
end
local function usableLabel(label)
local text = label.Text
return text ~= "" and #text <= 30 and not text:match("^[%d:%.%s]+$")
end
ForceMap.notMaps = { ["freeze tag"] = true, ["elite"] = true }
function ForceMap.scan()
local pads, labels = {}, {}
for _, descendant in ipairs(Workspace:GetDescendants()) do
if descendant:IsA("BasePart") and looksLikePad(descendant) then
pads[#pads + 1] = descendant
elseif descendant:IsA("TextLabel") and usableLabel(descendant) and not ForceMap.notMaps[(descendant.Text:gsub("^%s+", ""):gsub("%s+$", "")):lower()] then
local host = guiHost(descendant)
if host then
labels[#labels + 1] = { text = descendant.Text, host = host }
end
end
end
local best = {}
for _, pad in ipairs(pads) do
local nearest, nearestDistance = nil, 45
for _, label in ipairs(labels) do
local distance = (label.host.Position - pad.Position).Magnitude
if distance < nearestDistance then
nearest, nearestDistance = label, distance
end
end
if nearest then
local known = best[nearest.text]
if not known or nearestDistance < known.distance then
best[nearest.text] = { name = nearest.text, part = pad, distance = nearestDistance }
end
end
end
local spots = {}
for _, item in next, best do
spots[#spots + 1] = item
end
table.sort(spots, function(left, right)
return left.name < right.name
end)
ForceMap.spots = spots
return spots
end
function ForceMap.debug()
local root = rootOf(localPlayer)
if not root then
return false, "No character."
end
local lines = {}
for _, descendant in ipairs(Workspace:GetDescendants()) do
if descendant:IsA("BasePart") and looksLikePad(descendant) and (descendant.Position - root.Position).Magnitude < 120 then
lines[#lines + 1] = ("PAD   %s  [%s]"):format(descendant:GetFullName(), descendant.ClassName)
elseif descendant:IsA("TextLabel") and usableLabel(descendant) then
local host = guiHost(descendant)
if host and (host.Position - root.Position).Magnitude < 120 then
lines[#lines + 1] = ("LABEL %s = %q"):format(descendant:GetFullName(), descendant.Text)
end
end
end
local clipboard = setclipboard or toclipboard or set_clipboard
if typeof(clipboard) ~= "function" then
return false, "Your executor has no clipboard function."
end
pcall(clipboard, table.concat(lines, "\n"))
return true, #lines .. " lines copied."
end
local function textOfButton(button)
if button:IsA("TextButton") and button.Text ~= "" then
return button.Text
end
for _, inner in ipairs(button:GetDescendants()) do
if inner:IsA("TextLabel") and inner.Text ~= "" then
return inner.Text
end
end
return button.Name
end
function ForceMap.findButton(needle)
local playerGui = localPlayer:FindFirstChild("PlayerGui")
if not playerGui then
return nil
end
for _, descendant in ipairs(playerGui:GetDescendants()) do
if descendant:IsA("GuiButton") and nameHasVote(descendant) and textOfButton(descendant):lower():find(needle, 1, true) then
return descendant
end
end
return nil
end
function ForceMap.resolve(name)
local needle = name:lower()
for _, item in ipairs(ForceMap.spots) do
if item.part.Parent and item.name == name then
return item
end
end
for _, item in ipairs(ForceMap.spots) do
if item.part.Parent and item.name:lower():find(needle, 1, true) then
return item
end
end
for _, item in ipairs(ForceMap.scan()) do
if item.name:lower():find(needle, 1, true) then
return item
end
end
return nil
end
