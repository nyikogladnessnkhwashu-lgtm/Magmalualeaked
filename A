function Predict.noirUpdatePing()
local now = os.clock()
if now - Predict.noir.lastPing < 0.1 then
return
end
Predict.noir.lastPing = now
local ms = nil
pcall(function()
ms = game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue()
end)
if type(ms) ~= "number" or ms <= 0 then
ms = Predict.ping()
end
local measured = ms / 1000
if measured > 0 and measured < 2 then
Predict.noir.ping = Predict.noir.ping * 0.7 + measured * 0.3
end
