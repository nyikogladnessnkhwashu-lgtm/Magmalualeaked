function Predict.noirProfile(ms)
local list = Predict.noir.profiles
local first, second = list[1], list[1]
if ms >= list[#list].Ping then
first, second = list[#list], list[#list]
else
for index = 1, #list - 1 do
if ms >= list[index].Ping and ms <= list[index + 1].Ping then
first, second = list[index], list[index + 1]
break
end
end
end
local span = second.Ping - first.Ping
local alpha = span > 0 and math.clamp((ms - first.Ping) / span, 0, 1) or 0
alpha = alpha * alpha * (3 - 2 * alpha)
local function mix(key)
return math.floor(first[key] + (second[key] - first[key]) * alpha + 0.5)
end
return { Sim = mix("Sim"), Interval = mix("Interval"), H = mix("H"), V = mix("V"), X = mix("X"), Y = mix("Y"), Z = mix("Z") }
end
function Predict.noirLead(profile)
local ping = Predict.noir.ping
local prediction = ping + 0.02
prediction = prediction + math.clamp(profile.Interval / 2000, 0, 0.05) + math.max(0, ping - 0.10) * 0.15
local cap = profile.Sim / 1000
cap = math.min(0.30, cap + math.clamp(ping - 0.10, 0, 0.25) * 0.45)
return math.clamp(prediction, 0.02, cap)
end
function Predict.noirSample(part, intervalMs)
local entry = Predict.noir.motion[part]
