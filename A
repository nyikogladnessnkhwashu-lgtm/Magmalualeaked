colors.text, colors.accent, colors.accentLight, colors.accentDark = theme.textBright, theme.accent, theme.accentLight, theme.accentDark
if ForceMap.picker.gui then
ForceMap.destroyPicker()
ForceMap.picker.builtKey, ForceMap.picker.wasVisible = nil, false
ForceMap.buildPicker()
ForceMap.refreshPicker()
end
end
