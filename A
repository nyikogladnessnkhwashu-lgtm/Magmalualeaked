local ConfigShare = { pasted = "" }
function ConfigShare.copy()
local encoded = ui.Snapshot()
if encoded == "" then
return false, "Nothing to export."
end
local clipboard = setclipboard or toclipboard or set_clipboard
if typeof(clipboard) ~= "function" then
return false, "Your executor has no clipboard function."
end
return pcall(clipboard, "MAGMA1:" .. encoded)
end
function ConfigShare.import()
local text = tostring(ConfigShare.pasted or ""):gsub("^%s+", ""):gsub("%s+$", "")
if text:sub(1, 7) ~= "MAGMA1:" then
return false, "That isn't a Magma config."
end
local body = text:sub(8)
local ok, data = pcall(function()
return HttpService:JSONDecode(body)
end)
if not ok or type(data) ~= "table" then
return false, "The config text is damaged."
end
if not (writefile and makefolder and isfolder) then
return false, "Your executor can't write files."
end
for _, folder in ipairs({ "MagmaMM2", "MagmaMM2/configs" }) do
if not isfolder(folder) then
pcall(makefolder, folder)
end
end
if not pcall(writefile, "MagmaMM2/configs/imported.json", body) then
return false, "Couldn't save the imported config."
end
return ui.LoadConfig("imported")
end
